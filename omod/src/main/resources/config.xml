<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
		"https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.smartonfhir</package>
	<author>OpenMRS</author>
	<description>
		${project.parent.description}
	</description>

	<activator>org.openmrs.module.smartonfhir.SMARTonFHIRActivator</activator>

	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->

	<require_version>${openmrsPlatformVersion}</require_version>

	<require_modules>
		<require_module version="${fhir2Version}">org.openmrs.module.fhir2</require_module>
		<require_module version="${authenticationVersion}">org.openmrs.module.authentication</require_module>
	</require_modules>

	<servlet>
		<servlet-name>smartConfig</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartConfigServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>smartAccessConfirmation</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartAccessConfirmation</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>smartLaunchOptionSelected</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartLaunchOptionSelected</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>smartEhrLaunchServlet</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartEhrLaunchServlet</servlet-class>
	</servlet>

	<!--
		The apps a clinician may launch. Read by whatever offers a way to launch them; it never
		exposes an app's launch URL, which is the registry's business and nobody else's.
	-->
	<servlet>
		<servlet-name>smartApps</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartAppsServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>smartPatientSelection</servlet-name>
		<servlet-class>org.openmrs.module.smartonfhir.web.servlet.SmartPatientSelectionServlet</servlet-class>
	</servlet>

	<!--
		Authenticates FHIR requests carrying a SMART access token. Scoped to the FHIR API:
		nothing else accepts these tokens, and the filter this replaces was mapped to every
		request in the webapp.
	-->
	<filter>
		<filter-name>smartBearerTokenFilter</filter-name>
		<filter-class>org.openmrs.module.smartonfhir.web.filter.SmartBearerTokenFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>smartBearerTokenFilter</filter-name>
		<url-pattern>/ws/fhir2</url-pattern>
		<url-pattern>/ws/fhir2/*</url-pattern>
		<url-pattern>/ms/fhir2Servlet</url-pattern>
		<url-pattern>/ms/fhir2Servlet/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>smartCORSFilter</filter-name>
		<filter-class>org.openmrs.module.smartonfhir.web.filter.CORSFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>smartCORSFilter</filter-name>
		<url-pattern>/ws/fhir2</url-pattern>
		<url-pattern>/ws/fhir2/*</url-pattern>
	</filter-mapping>

	<!--
		Turns the authorization server's launch token into an OpenMRS session so the
		patient picker can render. Scoped to the launch paths: it was mapped to every
		request in the webapp, which meant its session-invalidating logic ran on every
		O3 REST call. The whitelist previously named RefApp 2.x pages that no longer
		exist. This moves to an authentication-module scheme, which owns session
		lifecycle, once the picker's own routes are settled.
	-->
	<filter>
		<filter-name>authenticationByPassFilter</filter-name>
		<filter-class>org.openmrs.module.smartonfhir.web.filter.AuthenticationByPassFilter</filter-class>
		<init-param>
			<param-name>validUrls</param-name>
			<param-value>/smartonfhir/smartAccessConfirmation,/ms/smartAccessConfirmation,/ms/smartLaunchOptionSelected,/ms/smartPatientSelection</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>authenticationByPassFilter</filter-name>
		<url-pattern>/smartonfhir/*</url-pattern>
		<url-pattern>/ms/smartAccessConfirmation</url-pattern>
		<url-pattern>/ms/smartAccessConfirmation/*</url-pattern>
		<url-pattern>/ms/smartLaunchOptionSelected</url-pattern>
		<!--
			Where the authorization server sends a launch that needs a patient chosen. The screen
			itself is a frontend module, and the single-page application host will not render any
			route without a session — it redirects to the login page instead, discarding the launch
			token. So the launch lands here first: this filter turns the token into a session, and
			the servlet then redirects to the frontend route with the session already in place.
		-->
		<url-pattern>/ms/smartPatientSelection</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>smartForwardingFilter</filter-name>
		<filter-class>org.openmrs.module.smartonfhir.web.filter.SmartForwardingFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>smartForwardingFilter</filter-name>
		<url-pattern>/ws/fhir2</url-pattern>
		<url-pattern>/ws/fhir2/*</url-pattern>
		<url-pattern>/ms/smartEhrLaunchServlet</url-pattern>
		<url-pattern>/ms/smartEhrLaunchServlet/*</url-pattern>
		<url-pattern>/ms/smartAccessConfirmation</url-pattern>
		<url-pattern>/ms/smartAccessConfirmation/*</url-pattern>
		<url-pattern>/smartonfhir/smartAccessConfirmation</url-pattern>
		<url-pattern>/smartonfhir/smartAccessConfirmation/*</url-pattern>
	</filter-mapping>

	<!-- Internationalization -->
	<!-- All message codes should start with @MODULE_ID@.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->
</module>

